{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "LanFlare",
  "version": "0.3.0",
  "identifier": "com.lanflare.desktop",
  "build": {
    "frontendDist": "../../web/build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LanFlare",
        "width": 960,
        "height": 680,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "LanFlare - Local Network File Transfer"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
